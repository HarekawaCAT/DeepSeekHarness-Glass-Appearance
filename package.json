{
  "name": "dsh-glass-appearance",
  "version": "1.8.2",
  "type": "module",
  "description": "Translucent sidebar, dialogs and cards over a custom wallpaper for the DeepSeek Harness Web UI, with per-panel opacity and blur",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "glassmorphism",
    "theme",
    "backdrop-filter"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarekawaCAT/DeepSeekHarness-Glass-Appearance.git"
  },
  "homepage": "https://github.com/HarekawaCAT/DeepSeekHarness-Glass-Appearance#readme",
  "bugs": {
    "url": "https://github.com/HarekawaCAT/DeepSeekHarness-Glass-Appearance/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "resources/README.txt",
    "docs"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
